{
  "name": "@acegalaxy/lib-model-registry",
  "version": "0.2.0",
  "description": "Notion-backed AI model registry — define model configs (provider, model, costs, capabilities) in a Notion table, sync to runtime via a single call. 3-layer fallback: Notion → cache → defaults.",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "tsc",
    "clean": "rm -rf dist",
    "pretest": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "model-registry",
    "notion",
    "claude",
    "gpt",
    "gemini",
    "deepseek"
  ],
  "author": "ACE Galaxy <oss@acegalaxy.co>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": "github:acegalaxy-co/lib-model-registry",
  "bugs": {
    "url": "https://github.com/acegalaxy-co/lib-model-registry/issues"
  },
  "homepage": "https://github.com/acegalaxy-co/lib-model-registry#readme",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^20.0.0"
  }
}
